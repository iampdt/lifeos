# Copy to .env (git-ignored) and fill in. Never commit real values.

# Notion internal integration secret (Settings → Connections → Develop or manage integrations)
NOTION_TOKEN=

# Life OS data sources (API data-source IDs) and their databases
NOTION_DS_TASKS=
NOTION_DB_TASKS=
NOTION_DS_GOALS=
NOTION_DB_GOALS=
NOTION_DS_HABITS=
NOTION_DB_HABITS=
NOTION_DS_WEEKS=
NOTION_DB_WEEKS=
NOTION_DS_MONTHS=
NOTION_DB_MONTHS=
NOTION_DS_BOOKS=
NOTION_DB_BOOKS=

# Sandbox copies used by write tests (profile: sandbox)
NOTION_SANDBOX_DS_TASKS=
NOTION_SANDBOX_DB_TASKS=
NOTION_SANDBOX_DS_HABITS=
NOTION_SANDBOX_DB_HABITS=
NOTION_SANDBOX_DS_WEEKS=
NOTION_SANDBOX_DB_WEEKS=
NOTION_SANDBOX_DS_MONTHS=
NOTION_SANDBOX_DB_MONTHS=

# Set to 1 to run tests marked `live` (read-only calls to the real API)
LIFEOS_LIVE_TESTS=0

# Gemini (Google AI Studio). Model choice is configuration, set in Phase 4b.
GEMINI_API_KEY=

# Local Postgres from docker-compose (defaults shown)
DATABASE_URL=postgresql+asyncpg://lifeos:lifeos@localhost:5433/lifeos
LIFEOS_TEST_DATABASE_URL=postgresql+asyncpg://lifeos:lifeos@localhost:5433/lifeos_test

# Kill switch for every Notion write. Keep false until you want LifeOS to apply approved changes.
LIFEOS_WRITES_ENABLED=false
NOTION_PROFILE=live
