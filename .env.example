# LifeOS configuration. Copy to .env (git-ignored) for local development; in production set
# these as environment variables on the host. Never commit real values.

# --- App -------------------------------------------------------------------------------------
# development | production (production hides the API docs and always uses Secure cookies)
LIFEOS_ENV=development
TIMEZONE=Asia/Kolkata
# Kill switch for every Notion write. Approvals are recorded either way.
LIFEOS_WRITES_ENABLED=false

# --- Notion ----------------------------------------------------------------------------------
# Internal integration secret (Notion → Settings → Connections → Develop or manage integrations)
NOTION_TOKEN=
# live = the real workspace; sandbox = the NOTION_SANDBOX_* copies used for write tests
NOTION_PROFILE=live
# Data-source IDs (and database IDs, used only by scripts/notion_check.py)
NOTION_DS_TASKS=
NOTION_DB_TASKS=
NOTION_DS_GOALS=
NOTION_DB_GOALS=
NOTION_DS_HABITS=
NOTION_DB_HABITS=
NOTION_DS_WEEKS=
NOTION_DB_WEEKS=
NOTION_DS_MONTHS=
NOTION_DB_MONTHS=
NOTION_DS_BOOKS=
NOTION_DB_BOOKS=
NOTION_SANDBOX_DS_TASKS=
NOTION_SANDBOX_DB_TASKS=
NOTION_SANDBOX_DS_HABITS=
NOTION_SANDBOX_DB_HABITS=
NOTION_SANDBOX_DS_WEEKS=
NOTION_SANDBOX_DB_WEEKS=
NOTION_SANDBOX_DS_MONTHS=
NOTION_SANDBOX_DB_MONTHS=

# --- LLM -------------------------------------------------------------------------------------
# Gemini API key (Google AI Studio). Without it, workflows use their rule-based fallbacks.
GEMINI_API_KEY=
# Pinned models, tried in order (fast: parsing and planning; smart: reviews)
LLM_FAST_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
LLM_SMART_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=30
LLM_DAILY_TOKEN_BUDGET=300000

# --- Database --------------------------------------------------------------------------------
# An asyncpg URL, or a plain postgresql:// URL as Neon provides it (?sslmode=require is fine)
DATABASE_URL=postgresql+asyncpg://lifeos:lifeos@localhost:5433/lifeos

# --- Access ----------------------------------------------------------------------------------
# Bearer token for scripts (python -c "import secrets; print(secrets.token_urlsafe(32))").
# Unset: bearer requests are refused; browser sessions still work.
LIFEOS_API_TOKEN=
# Session cookie. Keep true with HTTPS; set false only for local http development.
LIFEOS_COOKIE_SECURE=true
LIFEOS_SESSION_DAYS=14
# Shared secret for signed scheduled-job calls (the same value goes into GitHub Actions secrets).
# Unset: the cron endpoint is disabled.
LIFEOS_CRON_SECRET=

# --- Public demo (a separate deployment) ------------------------------------------------------
# In-memory sample workspace instead of Notion, with a "Try the demo" sign-in.
LIFEOS_DEMO_MODE=false
# Optional: use this database name in DATABASE_URL (it must contain "demo": the demo resets it).
LIFEOS_DEMO_DATABASE=

# --- Tests -----------------------------------------------------------------------------------
LIFEOS_TEST_DATABASE_URL=postgresql+asyncpg://lifeos:lifeos@localhost:5433/lifeos_test
# 1 = run tests marked `live` (reads the real workspace; writes only to the sandbox)
LIFEOS_LIVE_TESTS=0
